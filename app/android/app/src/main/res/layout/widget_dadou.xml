<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Dadou (Phase 8) : le logo (ouvre l'app) + 4 boutons favoris. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fond"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="4dp"
        android:contentDescription="Dadou"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/vide"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="Add favorites in Dadou (Controls, long press)"
        android:textColor="#C8C8EB"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/rangee"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/b0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_bouton"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <ImageView
                android:id="@+id/i0"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/t0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#C8C8EB"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/b1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_bouton"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <ImageView
                android:id="@+id/i1"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/t1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#C8C8EB"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/b2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_bouton"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <ImageView
                android:id="@+id/i2"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/t2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#C8C8EB"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/b3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_bouton"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <ImageView
                android:id="@+id/i3"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/t3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#C8C8EB"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
